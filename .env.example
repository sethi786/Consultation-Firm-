# Waypoint Security — environment variables
# Copy to .env.local for local dev. Never commit real values (.env* is gitignored).
# On Vercel, set these under Project → Settings → Environment Variables.

# ─────────────────────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────────────────────
# Public site origin (canonical URLs, sitemap, robots, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://waypointsecurity.com

# ─────────────────────────────────────────────────────────────────────────────
# Email — contact form delivery + autoresponder (Resend)
# ─────────────────────────────────────────────────────────────────────────────
# 1. Create a Resend account and add your sending domain (waypointsecurity.com).
# 2. Add the DKIM/SPF DNS records Resend gives you and wait for "Verified".
# 3. Create an API key (Sending access) and paste it below.
# Without RESEND_API_KEY the form still works and still stores the lead — it just
# logs instead of emailing, so local dev needs no key.
RESEND_API_KEY=
# Where new-assessment notifications are sent (your inbox).
CONTACT_TO=assessments@waypointsecurity.com
# The From address. MUST be on a domain verified in Resend, or sends will fail.
CONTACT_FROM="Waypoint Security <no-reply@waypointsecurity.com>"

# ─────────────────────────────────────────────────────────────────────────────
# Database — Payload CMS + Postgres (leads, CMS content, portal)
# ─────────────────────────────────────────────────────────────────────────────
# Any ONE of these is used (first match wins): DATABASE_URI, POSTGRES_URL,
# DATABASE_URL, POSTGRES_PRISMA_URL. A one-click Vercel Postgres injects
# POSTGRES_URL automatically; for Neon, paste the pooled connection string.
DATABASE_URI=postgresql://user:password@host:5432/waypoint?sslmode=require
# Long random string — signs Payload tokens. Generate: openssl rand -base64 32
PAYLOAD_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Portal auth — Auth.js v5 + Microsoft Entra ID (optional email/password too)
# ─────────────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=
# From your Entra ID app registration (leave blank to use email/password only).
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# ─────────────────────────────────────────────────────────────────────────────
# Media storage — Vercel Blob (production). Unset = local disk (dev only).
# ─────────────────────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Analytics — Plausible (cookieless). Off unless the domain is set.
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=waypointsecurity.com
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
